# Copy this file to ".env" and fill in real values. Never commit the real ".env".

# ---- Server ----
PORT=5000
JWT_SECRET=change-this-to-a-long-random-string
# The frontend origin allowed to call this API. Use * only for local testing.
CORS_ORIGIN=*

# ---- Database driver: "sqlite" or "postgres" ----
DB_TYPE=postgres

# ---- SQLite settings (used only when DB_TYPE=sqlite) ----
# Path is relative to the backend folder.
SQLITE_PATH=./classroom.db

# ---- PostgreSQL settings (used only when DB_TYPE=postgres) ----
# Option A: a single connection string (Render/Heroku/Supabase/Neon style)
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Option B: discrete fields (used only if DATABASE_URL is not set)
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=12345
PG_DATABASE=classroom
# Set to "true" if your Postgres host requires SSL (most managed hosts do)
PG_SSL=false
